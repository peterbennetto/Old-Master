# Google Gemini — required. Free key from https://aistudio.google.com/apikey
# Powers all three steps: speech-to-text, the Brain, and text-to-speech.
# Locally: copy this file to .env.local. On Vercel: add it under
# Project Settings -> Environment Variables (never commit the real key).
GEMINI_API_KEY=your-gemini-key-here

# Optional model overrides (defaults shown). Change these if Google retires a
# model or you hit a free-tier quota on one — no code change needed.
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_STT_MODEL=gemini-3.5-flash-lite
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Algenib

# Anthropic — only needed if you switch the Brain to Claude
# ANTHROPIC_API_KEY=sk-ant-your-key-here
